# Build outputs
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/

# .NET / NuGet
*.user
*.suo
*.userosscache
*.sln.docstates
*.pidb
*.svclog
*.pdb
*.cache
/packages/
project.lock.json
project.fragment.lock.json
artifacts/

# Rider / IntelliJ
.idea/
.idea/**
*.iml
*.iws
*.ipr

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# What Puls's running stack keeps (puls-mongo's data folder)
/data/

# Secrets and local configuration in config/ (see its .env.secrets.example)
/config/.env
/config/.env.secrets
/config/.env.mongo
/config/.env.searxng
/config/.env.secrets.local
/config/.env.local

# Agent-built tools and skill files awaiting /approve (approved ones in skills/ are committed)
/skills/tools/pending/
/skills/agent/functions/pending/

# What the build makes from the web app's Styles/
/src/Puls.Web/wwwroot/css/
# What the build makes from a component's own X.razor.scss, beside it; Blazor bundles it from there
**/*.razor.css
