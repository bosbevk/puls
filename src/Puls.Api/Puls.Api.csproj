<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Puls.Api</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- The framework's API; this program says what it loads, and serves what this project references. -->
            <PackageReference Include="LouisAgent.Core.Web" Version="0.1.0" />
            <PackageReference Include="LouisAgent.Core.Telemetry" Version="0.1.0" />
        <!-- CL57: the model providers this program composes; core ships no SDK. -->
        <PackageReference Include="LouisAgent.Core.Anthropic" Version="0.1.0" />
        <PackageReference Include="LouisAgent.Core.Ollama" Version="0.1.0" />
        <PackageReference Include="LouisAgent.Core.OpenAi" Version="0.1.0" />
<PackageReference Include="LouisAgent.Api" Version="0.1.0" />
        <!-- CL57: the eval studio, a library on the API a program opts into. -->
        <PackageReference Include="LouisAgent.Api.Evals" Version="0.1.0" />
        <!-- The framework's accounts (F61): sign-in, registration and profiles, on when ACCOUNTS_SQL_URL is set. -->
        <PackageReference Include="LouisAgent.Accounts" Version="0.1.0" />
        <!-- Puls's list of identities and packs, chosen by IDENTITIES and PACKS at start-up. -->
        <ProjectReference Include="..\..\src\Puls.HostPacks\Puls.HostPacks.csproj" />
        <!-- The web app this program serves. Its files reach this project's output through this reference. -->
        <ProjectReference Include="..\..\src\Puls.Web\Puls.Web.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15" />
    </ItemGroup>

</Project>
