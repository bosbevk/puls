<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Puls.Evals.Runner</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- The framework's eval runner; this program only says what Puls's evals can name. -->
        <PackageReference Include="LouisAgent.Evals.Runner" Version="0.2.0" />
        <!-- CL57: the program, not the runner library, decides the telemetry. -->
        <PackageReference Include="LouisAgent.Core.Telemetry" Version="0.1.0" />
        <!-- CL57: the model providers this program composes; core ships no SDK. -->
        <PackageReference Include="LouisAgent.Core.Anthropic" Version="0.1.0" />
        <PackageReference Include="LouisAgent.Core.Ollama" Version="0.1.0" />
        <PackageReference Include="LouisAgent.Core.OpenAi" Version="0.1.0" />
        <!-- ADR 0073: what proves Puls and its packs. Only this program references them, so no host carries a check, and
             their eval folders reach this program's output through these references. -->
        <ProjectReference Include="..\..\src\Puls.Judges\Puls.Judges.csproj" />
        <ProjectReference Include="..\..\src\Puls.Evals\Puls.Evals.csproj" />
        <ProjectReference Include="..\..\src\Puls.Packs.WhereToBuy.Checks\Puls.Packs.WhereToBuy.Checks.csproj" />
        <ProjectReference Include="..\..\src\Puls.Packs.Recipes.Checks\Puls.Packs.Recipes.Checks.csproj" />
        <!-- F49.2: Puls's list of identities and packs, for the toolsets an eval's modes name. -->
        <ProjectReference Include="..\..\src\Puls.HostPacks\Puls.HostPacks.csproj" />
    </ItemGroup>

</Project>
