<Project Sdk="Microsoft.NET.Sdk">

  <!-- Where to buy (F50.2, ADR 0027, 0028, 0069): a shop's branches near the user's town from OpenStreetMap's
       Nominatim. It took the place of the shops pack. References core alone; the rules that prove it are the project
       beside it, Puls.Packs.WhereToBuy.Checks (ADR 0073). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Puls.Packs.WhereToBuy</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keeps the embedded guide's folder path: without it, toolsets/where-to-buy.md is never found. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Puls.Packs.WhereToBuy.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LouisAgent.Composition" Version="0.2.0" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="prompts\**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\docs\projects\Puls.Packs.WhereToBuy.md" Link="docs\Puls.Packs.WhereToBuy.md" />
    <None Include="..\..\..\src\docs\guides\build-a-pack.md" Link="docs\build-a-pack.md" />
  </ItemGroup>

</Project>
